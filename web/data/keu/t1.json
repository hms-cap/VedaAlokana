{"1":[[1,["ॐ आप्यायन्तु ममाङ्गानि वाक्प्राणश्चक्षुः","श्रोत्रमथो बलमिन्द्रियाणि च सर्वाणि ।","सर्वं ब्रह्मौपनिषदं","माऽहं ब्रह्म निराकुर्यां मा मा ब्रह्म","निराकरोदनिराकरणमस्त्वनिराकरणं मेऽस्तु ।","तदात्मनि निरते य","उपनिषत्सु धर्मास्ते मयि सन्तु ते मयि सन्तु ।","मेद्स्किप्ह्रुलेमेद्स्किप्","ॐ केनेषितं पतति प्रेषितं मनः","केन प्राणः प्रथमः प्रैति युक्तः ।","केनेषितां वाचमिमां वदन्ति","चक्षुः श्रोत्रं क उ देवो युनक्ति"],["oṃ āpyāyantu mamāṅgāni vākprāṇaścakṣuḥ","śrotramatho balamindriyāṇi ca sarvāṇi |","sarvaṃ brahmaupaniṣadaṃ","mā'haṃ brahma nirākuryāṃ mā mā brahma","nirākarodanirākaraṇamastvanirākaraṇaṃ me'stu |","tadātmani nirate ya","upaniṣatsu dharmāste mayi santu te mayi santu |","medskiphrulemedskip","oṃ keneṣitaṃ patati preṣitaṃ manaḥ","kena prāṇaḥ prathamaḥ praiti yuktaḥ |","keneṣitāṃ vācamimāṃ vadanti","cakṣuḥ śrotraṃ ka u devo yunakti"],[],"",""],[2,["श्रोत्रस्य श्रोत्रं मनसो मनो यद्","वाचो ह वाचं स उ प्राणस्य प्राणः ।","चक्षुषश्चक्षुरतिमुच्य धीराः","प्रेत्यास्माल्लोकादमृता भवन्ति"],["śrotrasya śrotraṃ manaso mano yad","vāco ha vācaṃ sa u prāṇasya prāṇaḥ |","cakṣuṣaścakṣuratimucya dhīrāḥ","pretyāsmāllokādamṛtā bhavanti"],[],"",""],[3,["न तत्र चक्षुर्गच्छति न वाग्गच्छति नो मनः ।","न विद्मो न विजानीमो यथैतदनुशिष्यात्"],["na tatra cakṣurgacchati na vāggacchati no manaḥ |","na vidmo na vijānīmo yathaitadanuśiṣyāt"],[],"",""],[4,["अन्यदेव तद्विदितादथो अविदितादधि ।","इति शुश्रुम पूर्वेषां ये नस्तद्व्याचचक्षिरे"],["anyadeva tadviditādatho aviditādadhi |","iti śuśruma pūrveṣāṃ ye nastadvyācacakṣire"],[],"",""],[5,["यद्वाचाऽनभ्युदितं येन वागभ्युद्यते ।","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],["yadvācā'nabhyuditaṃ yena vāgabhyudyate |","tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"],[],"",""],[6,["यन्मनसा न मनुते येनाहुर्मनो मतम् ।","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],["yanmanasā na manute yenāhurmano matam |","tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"],[],"",""],[7,["यच्चक्षुषा न पश्यति येन चक्षूंषि पश्यति ।","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],["yaccakṣuṣā na paśyati yena cakṣūṃṣi paśyati |","tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"],[],"",""],[8,["यच्छ्रोत्रेण न शृणोति येन श्रोत्रमिदं श्रुतम् ।","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],["yacchrotreṇa na śṛṇoti yena śrotramidaṃ śrutam |","tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"],[],"",""],[9,["यत्प्राणेन न प्राणिति येन प्राणः प्रणीयते ।","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],["yatprāṇena na prāṇiti yena prāṇaḥ praṇīyate |","tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"],[],"",""]],"2":[[1,["॥ इति केनोपनिषदि प्रथमः खण्डः ॥","द्वितीयखण्डः।","यदि मन्यसे सुवेदेति दहरमेवापि","नूनं त्वं वेत्थ ब्रह्मणो रूपम् ।","यदस्य त्वं यदस्य देवेष्वथ नु","मीमांस्येमेव ते मन्ये विदितम्"],["|| iti kenopaniṣadi prathamaḥ khaṇḍaḥ ||","dvitīyakhaṇḍaḥ|","yadi manyase suvedeti daharamevāpi","nūnaṃ tvaṃ vettha brahmaṇo rūpam |","yadasya tvaṃ yadasya deveṣvatha nu","mīmāṃsyemeva te manye viditam"],[],"",""],[2,["नाहं मन्ये सुवेदेति नो न वेदेति वेद च ।","यो नस्तद्वेद तद्वेद नो न वेदेति वेद च"],["nāhaṃ manye suvedeti no na vedeti veda ca |","yo nastadveda tadveda no na vedeti veda ca"],[],"",""],[3,["यस्यामतं तस्य मतं मतं यस्य न वेद सः ।","अविङ्य़ातं विजानतां विङ्य़ातमविजानताम्"],["yasyāmataṃ tasya mataṃ mataṃ yasya na veda saḥ |","aviṅyātaṃ vijānatāṃ viṅyātamavijānatām"],[],"",""],[4,["प्रतिबोधविदितं मतममृतत्वं हि विन्दते ।","आत्मना विन्दते वीर्यं विद्यया विन्दतेऽमृतम्"],["pratibodhaviditaṃ matamamṛtatvaṃ hi vindate |","ātmanā vindate vīryaṃ vidyayā vindate'mṛtam"],[],"",""],[5,["इह चेदवेदीदथ सत्यमस्ति","न चेदिहावेदीन्महती विनष्टिः ।","भूतेषु भूतेषु विचित्य धीराः","प्रेत्यास्माल्लोकादमृता भवन्ति"],["iha cedavedīdatha satyamasti","na cedihāvedīnmahatī vinaṣṭiḥ |","bhūteṣu bhūteṣu vicitya dhīrāḥ","pretyāsmāllokādamṛtā bhavanti"],[],"",""]],"3":[[1,["॥ इति केनोपनिषदि द्वितीयः खण्डः ॥","द्वितीयखण्डः।","ब्रह्म ह देवेभ्यो विजिग्ये तस्य ह ब्रह्मणो","विजये देवा अमहीयन्त"],["|| iti kenopaniṣadi dvitīyaḥ khaṇḍaḥ ||","dvitīyakhaṇḍaḥ|","brahma ha devebhyo vijigye tasya ha brahmaṇo","vijaye devā amahīyanta"],[],"",""],[2,["त ऐक्षन्तास्माकमेवायं विजयोऽस्माकमेवायं महिमेति ।","तद्धैषां विजङ्य़ौ तेभ्यो ह प्रादुर्बभूव तन्न व्यजानत","किमिदं यक्षमिति"],["ta aikṣantāsmākamevāyaṃ vijayo'smākamevāyaṃ mahimeti |","taddhaiṣāṃ vijaṅyau tebhyo ha prādurbabhūva tanna vyajānata","kimidaṃ yakṣamiti"],[],"",""],[3,["तेऽग्निमब्रुवञ्जातवेद एतद्विजानीहि","किमिदं यक्षमिति तथेति"],["te'gnimabruvañjātaveda etadvijānīhi","kimidaṃ yakṣamiti tatheti"],[],"",""],[4,["तदभ्यद्रवत्तमभ्यवदत्कोऽसीत्यग्निर्वा","अहमस्मीत्यब्रवीज्जातवेदा वा अहमस्मीति"],["tadabhyadravattamabhyavadatko'sītyagnirvā","ahamasmītyabravījjātavedā vā ahamasmīti"],[],"",""],[5,["तस्मि{म्+}स्त्वयि किं वीर्यमित्यपीद{म्+} सर्वं","दहेयं यदिदं पृथिव्यामिति"],["tasmi{m+}stvayi kiṃ vīryamityapīda{m+} sarvaṃ","daheyaṃ yadidaṃ pṛthivyāmiti"],[],"",""],[6,["तस्मै तृणं निदधावेतद्दहेति ।","तदुपप्रेयाय सर्वजवेन तन्न शशाक दग्धुं स तत एव","निववृते नैतदशकं विङ्य़ातुं यदेतद्यक्षमिति"],["tasmai tṛṇaṃ nidadhāvetaddaheti |","tadupapreyāya sarvajavena tanna śaśāka dagdhuṃ sa tata eva","nivavṛte naitadaśakaṃ viṅyātuṃ yadetadyakṣamiti"],[],"",""],[7,["अथ वायुमब्रुवन्वायवेतद्विजानीहि","किमेतद्यक्षमिति तथेति"],["atha vāyumabruvanvāyavetadvijānīhi","kimetadyakṣamiti tatheti"],[],"",""],[8,["तदभ्यद्रवत्तमभ्यवदत्कोऽसीति वायुर्वा","अहमस्मीत्यब्रवीन्मातरिश्वा वा अहमस्मीति"],["tadabhyadravattamabhyavadatko'sīti vāyurvā","ahamasmītyabravīnmātariśvā vā ahamasmīti"],[],"",""],[9,["तस्मिंस्त्वयि किं वीर्यमित्यपीदं","सर्वमाददीय यदिदं पृथिव्यामिति"],["tasmiṃstvayi kiṃ vīryamityapīdaṃ","sarvamādadīya yadidaṃ pṛthivyāmiti"],[],"",""],[10,["तस्मै तृणं निदधावेतदादत्स्वेति","तदुपप्रेयाय सर्वजवेन तन्न शशाकादतुं स तत एव","निववृते नैतदशकं विङ्य़ातुं यदेतद्यक्षमिति"],["tasmai tṛṇaṃ nidadhāvetadādatsveti","tadupapreyāya sarvajavena tanna śaśākādatuṃ sa tata eva","nivavṛte naitadaśakaṃ viṅyātuṃ yadetadyakṣamiti"],[],"",""],[11,["अथेन्द्रमब्रुवन्मघवन्नेतद्विजानीहि किमेतद्यक्षमिति तथेति","तदभ्यद्रवत्तस्मात्तिरोदधे"],["athendramabruvanmaghavannetadvijānīhi kimetadyakṣamiti tatheti","tadabhyadravattasmāttirodadhe"],[],"",""],[12,["स तस्मिन्नेवाकाशे स्त्रियमाजगाम बहुशोभमानामुमां","हैमवतीं तांहोवाच किमेतद्यक्षमिति"],["sa tasminnevākāśe striyamājagāma bahuśobhamānāmumāṃ","haimavatīṃ tāṃhovāca kimetadyakṣamiti"],[],"",""]],"4":[[1,["॥ इति केनोपनिषदि तृतीयः खण्डः ॥","चतुर्थः खण्डः।","सा ब्रह्मेति होवाच ब्रह्मणो वा एतद्विजये महीयध्वमिति","ततो हैव विदाञ्चकार ब्रह्मेति"],["|| iti kenopaniṣadi tṛtīyaḥ khaṇḍaḥ ||","caturthaḥ khaṇḍaḥ|","sā brahmeti hovāca brahmaṇo vā etadvijaye mahīyadhvamiti","tato haiva vidāñcakāra brahmeti"],[],"",""],[2,["तस्माद्वा एते देवा अतितरामिवान्यान्देवान्यदग्निर्वायुरिन्द्रस्ते","ह्येनन्नेदिष्ठं पस्पर्शुस्ते ह्येनत्प्रथमो विदाञ्चकार ब्रह्मेति"],["tasmādvā ete devā atitarāmivānyāndevānyadagnirvāyurindraste","hyenannediṣṭhaṃ pasparśuste hyenatprathamo vidāñcakāra brahmeti"],[],"",""],[3,["तस्माद्वा इन्द्रोऽतितरामिवान्यान्देवान्स","ह्येनन्नेदिष्ठं पस्पर्श स ह्येनत्प्रथमो विदाञ्चकार ब्रह्मेति"],["tasmādvā indro'titarāmivānyāndevānsa","hyenannediṣṭhaṃ pasparśa sa hyenatprathamo vidāñcakāra brahmeti"],[],"",""],[4,["तस्यैष आदेशो यदेतद्विद्युतो व्यद्युतदा३","इतीन् न्यमीमिषदा३ इत्यधिदैवतम्"],["tasyaiṣa ādeśo yadetadvidyuto vyadyutadā3","itīn nyamīmiṣadā3 ityadhidaivatam"],[],"",""],[5,["अथाध्यात्मं यद्देतद्गच्छतीव च मनोऽनेन","चैतदुपस्मरत्यभीक्ष्णं सङ्कल्पः"],["athādhyātmaṃ yaddetadgacchatīva ca mano'nena","caitadupasmaratyabhīkṣṇaṃ saṅkalpaḥ"],[],"",""],[6,["तद्ध तद्वनं नाम तद्वनमित्युपासितव्यं स य एतदेवं वेदाभि","हैन{म्+} सर्वाणि भूतानि संवाञ्छन्ति"],["taddha tadvanaṃ nāma tadvanamityupāsitavyaṃ sa ya etadevaṃ vedābhi","haina{m+} sarvāṇi bhūtāni saṃvāñchanti"],[],"",""],[7,["उपनिषदं भो ब्रूहीत्युक्ता त उपनिषद्ब्राह्मीं वाव त","उपनिषदमब्रूमेति"],["upaniṣadaṃ bho brūhītyuktā ta upaniṣadbrāhmīṃ vāva ta","upaniṣadamabrūmeti"],[],"",""],[8,["तसै तपो दमः कर्मेति प्रतिष्ठा वेदाः सर्वाङ्गानि","सत्यमायतनम्"],["tasai tapo damaḥ karmeti pratiṣṭhā vedāḥ sarvāṅgāni","satyamāyatanam"],[],"",""],[9,["यो वा एतामेवं वेदापहत्य पाप्मानमनन्ते स्वर्गे","लोके ज्येये प्रतितिष्ठति प्रतितिष्ठति"],["yo vā etāmevaṃ vedāpahatya pāpmānamanante svarge","loke jyeye pratitiṣṭhati pratitiṣṭhati"],[],"",""],[10,["॥ इति केनोपनिषदि चतुर्थः खण्डः ॥","ॐ आप्यायन्तु ममाङ्गानि वाक्प्राणश्चक्षुः","श्रोत्रमथो बलमिन्द्रियाणि च सर्वाणि ।","सर्वं ब्रह्मौपनिषदं","माऽहं ब्रह्म निराकुर्यां मा मा ब्रह्म","निराकरोदनिराकरणमस्त्वनिराकरणं मेऽस्तु ।","तदात्मनि निरते य","उपनिषत्सु धर्मास्ते मयि सन्तु ते मयि सन्तु ।","इति केनोपनिषत् ॥","]"],["|| iti kenopaniṣadi caturthaḥ khaṇḍaḥ ||","oṃ āpyāyantu mamāṅgāni vākprāṇaścakṣuḥ","śrotramatho balamindriyāṇi ca sarvāṇi |","sarvaṃ brahmaupaniṣadaṃ","mā'haṃ brahma nirākuryāṃ mā mā brahma","nirākarodanirākaraṇamastvanirākaraṇaṃ me'stu |","tadātmani nirate ya","upaniṣatsu dharmāste mayi santu te mayi santu |","iti kenopaniṣat ||","]"],[],"",""]]}